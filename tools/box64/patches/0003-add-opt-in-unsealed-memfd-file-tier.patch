+// The native syscall validates the name and flags before a file-backed tier is considered.
+// Sealing/hugetlb/exec-policy requests retain the native kernel implementation.
+static int compat_memfd_create(const char* name, uint32_t flags)
+{
+    int native = syscall(__NR_memfd_create, name, flags);
+    if(native < 0)
+        return -1;
+    const char* directory = getenv("DROIDDECK_BOX64_MEMFD_DIR");
+    if(!directory || !directory[0] || (flags & ~1u))
+        return native;
+    const char* force = getenv("DROIDDECK_BOX64_MEMFD_FORCE_FILE");
+    if(!force || strcmp(force, "1")) {
+        char path[64];
+        snprintf(path, sizeof(path), "/proc/self/fd/%d", native);
+        int check = open(path, O_RDONLY | O_CLOEXEC);
+        if(check >= 0) {
+            close(check);
+            return native;
+        }
+        if(errno != EACCES && errno != EPERM)
+            return native;
+    }
+    int dirfd = open(directory, O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+    struct stat st;
+    if(dirfd < 0 || fstat(dirfd, &st) || st.st_uid != geteuid() || (st.st_mode & 0077)) {
+        int error = dirfd < 0 ? errno : EACCES;
+        if(dirfd >= 0)
+            close(dirfd);
+        close(native);
+        errno = error;
+        return -1;
+    }
+    close(dirfd);
+    char path[PATH_MAX];
+    if(snprintf(path, sizeof(path), "%s/box64-memfd-XXXXXX", directory) >= sizeof(path)) {
+        close(native);
+        errno = ENAMETOOLONG;
+        return -1;
+    }
+    int fd = mkostemp(path, (flags & 1) ? O_CLOEXEC : 0);
+    if(fd < 0) {
+        int error = errno;
+        close(native);
+        errno = error;
+        return -1;
+    }
+    if(fchmod(fd, 0777) || unlink(path)) {
+        int error = errno;
+        close(fd);
+        unlink(path);
+        close(native);
+        errno = error;
+        return -1;
+    }
+    close(native);
+    printf_log(LOG_INFO, "Compat memfd: private file tier, flags=0x%x\n", flags);
+    return fd;
+}

