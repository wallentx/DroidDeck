diff --git a/src/include/droiddeck_loader_trace.h b/src/include/droiddeck_loader_trace.h
new file mode 100644
--- /dev/null
+++ b/src/include/droiddeck_loader_trace.h
@@ -0,0 +1,20 @@
+#ifndef DROIDDECK_LOADER_TRACE_H
+#define DROIDDECK_LOADER_TRACE_H
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include "debug.h"
+static inline int dd_loader_trace_enabled(void)
+{
+    const char* value = getenv("DROIDDECK_BOX64_LOADER_TRACE");
+    return value && !strcmp(value, "1");
+}
+// Preserve the operation's errno and avoid logging environment or buffer contents.
+#define DD_LOADER_TRACE(format, ...) do { \
+    int dd_trace_errno = errno; \
+    if(dd_loader_trace_enabled()) \
+        printf_log(LOG_INFO, "[DD_LOADER pid=%d] " format, (int)getpid(), ##__VA_ARGS__); \
+    errno = dd_trace_errno; \
+} while(0)
+#endif
