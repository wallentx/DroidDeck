+#!/bin/sh
+# Host-side DirectAudio mixer regression test.  It deliberately builds the
+# actual mixer slice twice: production dispatch and DA_MIX_FORCE_SCALAR.
+set -eu
+
+root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
+cc=${CC:-cc}
+tmp_root=${TMPDIR:-/tmp}
+tmp=$(mktemp -d "$tmp_root/directaudio-mixer-test.XXXXXX")
+trap 'rm -rf "$tmp"' EXIT HUP INT TERM
+
+sh "$root/tests/extract-mixer-under-test.sh" "$root/directaudio.c" "$tmp/directaudio_mix_under_test.inc"
+
+compile_and_run() {
+    name=$1
+    shift
+    "$cc" -std=c11 -O2 -Wall -Wextra -Werror -UNDEBUG \
+        -I"$root" -I"$tmp" "$@" "$root/tests/directaudio_mixer_semantics_test.c" \
+        -pthread -o "$tmp/$name"
+    "$tmp/$name"
+}
+
+compile_and_run mixer-neon
+compile_and_run mixer-scalar -DDA_MIX_FORCE_SCALAR
+
+# AddressSanitizer and UBSan are mandatory in component CI.  A toolchain that
+# cannot link them needs a deliberate CI configuration change; it must never
+# turn a sanitizer test failure into a passing result.
+compile_and_run mixer-sanitized -O1 -g -fno-omit-frame-pointer \
+    -fsanitize=address,undefined
+echo "sanitizers: passed"
diff --git a/tests/extract-mixer-under-test.sh b/tests/extract-mixer-under-test.sh
new file mode 100755
--- /dev/null
+++ b/tests/extract-mixer-under-test.sh
@@ -0,0 +1,24 @@
+#!/bin/sh
+# Extract the mixer slice from the source under test.  The host regression test
+# supplies only the types that slice needs, so it exercises the real selector,
+# ring split, and accounting code without building Wine or Android.
+set -eu
+
+if [ "$#" -ne 2 ]; then
+    echo "usage: $0 DIRECTAUDIO_C OUTPUT_INC" >&2
+    exit 2
+fi
+
+src=$1
+out=$2
+
+awk '
+    /\/\* one source sample of channel c -> float in \[-1,1\] \*\// { emit = 1 }
+    /\/\* Produce numFrames of the mixed output:/ { exit }
+    emit { print }
+' "$src" >"$out"
+
+if ! grep -q '^static void mix_voice(' "$out"; then
+    echo "failed to extract mix_voice from $src" >&2
+    exit 1
+fi
diff --git a/tools/bench-directaudio-mixer.c b/tools/bench-directaudio-mixer.c
new file mode 100644
--- /dev/null
+++ b/tools/bench-directaudio-mixer.c
@@ -0,0 +1,320 @@
+/*
+ * DirectAudio packed-stereo mixer benchmark.
+ *
+ * It imports the host fixture used by the regression test.  That fixture
+ * extracts the current production mix_voice from directaudio.c, while
+ * ref_mix_voice is a pinned 52aedbf generic reference.  Thus every lane keeps
+ * the driver's format selection, modulo ring addressing, mutex, accounting,
+ * source buffers, output clear, and held-frame replenishment intact.
+ */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <inttypes.h>
+#include <sched.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+/* The regression fixture supplies the small Wine-type shim, extracted actual
+ * mix_voice, and the pinned-original ref_mix_voice. */
+#define main directaudio_mixer_semantics_fixture_main
+#include "../tests/directaudio_mixer_semantics_test.c"
+#undef main
+
+enum { BENCH_RING_CAP = 1021, BENCH_MAX_VOICES = 64 };
+
+enum sample_format { FORMAT_F32, FORMAT_S16 };
+
+struct options
+{
+    unsigned frames, voices, ring_frames, iterations, trials, warmup;
+    enum sample_format format;
+    int apply_gain, cpu, json, csv, csv_header;
+};
+
+struct bench_voice
+{
+    struct directaudio_stream actual, reference;
+    WAVEFORMATEX format;
+    BYTE *audio;
+    UINT32 initial_offset;
+};
+
+static volatile uint32_t bench_sink;
+
+#if defined(DA_BENCH_BASELINE)
+# define LANE_NAME "baseline"
+#elif defined(DA_MIX_FORCE_SCALAR)
+# define LANE_NAME "scalar"
+#else
+# define LANE_NAME "neon"
+#endif
+
+static uint64_t now_ns(void)
+{
+    struct timespec ts;
+    if (clock_gettime(CLOCK_MONOTONIC, &ts))
+    {
+        perror("clock_gettime");
+        exit(1);
+    }
+    return (uint64_t)ts.tv_sec * 1000000000u + (uint64_t)ts.tv_nsec;
+}
+
+static uint32_t bench_next_random(uint32_t *state)
+{
+    *state = *state * 1664525u + 1013904223u;
+    return *state;
+}
+
+static void bench_fill_audio(BYTE *audio, const struct options *options)
+{
+    uint32_t random = 0x8badf00du;
+    unsigned frame, channel;
+    unsigned align = options->format == FORMAT_F32 ? 8 : 4;
+
+    for (frame = 0; frame < options->ring_frames; frame++)
+    {
+        BYTE *dst = audio + (size_t)frame * align;
+        for (channel = 0; channel < 2; channel++)
+        {
+            if (options->format == FORMAT_F32)
+            {
+                float value = ((int32_t)bench_next_random(&random) / 2147483648.0f);
+                memcpy(dst + channel * sizeof(value), &value, sizeof(value));
+            }
+            else
+            {
+                int16_t value = (int16_t)bench_next_random(&random);
+                memcpy(dst + channel * sizeof(value), &value, sizeof(value));
+            }
+        }
+    }
+}
+
+static void reset_voice(struct bench_voice *voice, const struct options *options)
+{
+    struct directaudio_stream *actual = &voice->actual;
+    struct directaudio_stream *reference = &voice->reference;
+
+    actual->playing = reference->playing = 1;
+    actual->bufsize_frames = reference->bufsize_frames = options->ring_frames;
+    actual->lcl_offs_frames = reference->lcl_offs_frames = voice->initial_offset;
+    actual->held_frames = reference->held_frames = options->ring_frames;
+    actual->fmt = reference->fmt = &voice->format;
+    actual->local_buffer = reference->local_buffer = voice->audio;
+    actual->aa_rate = reference->aa_rate = MIX_OUT_RATE;
+    actual->is_float = reference->is_float = options->format == FORMAT_F32;
+    actual->vols_active = reference->vols_active = options->apply_gain;
+    actual->rs_pos = reference->rs_pos = 0.0;
+}
+
+static void replenish_voice(struct bench_voice *voice, const struct options *options)
+{
+    /* A game client keeps writing each render period.  Replenish only held
+     * state after the mixer consumes a block; no audio buffer is copied. */
+    voice->actual.held_frames = options->ring_frames;
+    voice->reference.held_frames = options->ring_frames;
+}
+
+static uint64_t run_blocks(const struct options *options, struct bench_voice *voices,
+                           float *out, unsigned blocks)
+{
+    uint64_t start;
+    unsigned block, voice;
+
+    start = now_ns();
+    for (block = 0; block < blocks; block++)
+    {
+        memset(out, 0, 2 * options->frames * sizeof(*out));
+        for (voice = 0; voice < options->voices; voice++)
+        {
+#if defined(DA_BENCH_BASELINE)
+            pthread_mutex_lock(&voices[voice].reference.lock);
+            ref_mix_voice(&voices[voice].reference, out, (int32_t)options->frames);
+            pthread_mutex_unlock(&voices[voice].reference.lock);
+#else
+            mix_voice(&voices[voice].actual, out, (int32_t)options->frames);
+#endif
+            replenish_voice(&voices[voice], options);
+        }
+        /* One volatile observation per completed audio block keeps the timed
+         * computation live without copying source or output buffers. */
+        bench_sink ^= bits(out[2 * (block % options->frames)]);
+    }
+    return now_ns() - start;
+}
+
+static int compare_u64(const void *left, const void *right)
+{
+    uint64_t a = *(const uint64_t *)left, b = *(const uint64_t *)right;
+    return a < b ? -1 : a > b;
+}
+
+static unsigned percentile_index(unsigned count, unsigned percent)
+{
+    return (count * percent + 99) / 100 - 1;
+}
+
+static void usage(const char *program)
+{
+    fprintf(stderr,
+            "usage: %s [--frames N] [--voices N] [--ring N] [--iterations N]\n"
+            "          [--trials N] [--warmup N] [--format f32|s16]\n"
+            "          [--gain on|off] [--cpu 0|2|6] [--json|--csv]\n", program);
+}
+
+static unsigned parse_unsigned(const char *name, const char *value, unsigned maximum)
+{
+    char *end;
+    unsigned long parsed = strtoul(value, &end, 10);
+    if (!*value || *end || parsed > maximum)
+    {
+        fprintf(stderr, "invalid %s: %s\n", name, value);
+        exit(2);
+    }
+    return (unsigned)parsed;
+}
+
+static void parse_options(int argc, char **argv, struct options *options)
+{
+    int i;
+    *options = (struct options){48, 1, BENCH_RING_CAP, 1000, 7, 100, FORMAT_F32, 1, -1, 0, 0, 1};
+    for (i = 1; i < argc; i++)
+    {
+        const char *flag = argv[i];
+        if (!strcmp(flag, "--help")) { usage(argv[0]); exit(0); }
+        if (!strcmp(flag, "--json")) { options->json = 1; continue; }
+        if (!strcmp(flag, "--csv")) { options->csv = 1; continue; }
+        if (!strcmp(flag, "--csv-no-header")) { options->csv = 1; options->csv_header = 0; continue; }
+        if (++i == argc) { usage(argv[0]); exit(2); }
+        if (!strcmp(flag, "--frames")) options->frames = parse_unsigned("frames", argv[i], MAX_FRAMES);
+        else if (!strcmp(flag, "--voices")) options->voices = parse_unsigned("voices", argv[i], BENCH_MAX_VOICES);
+        else if (!strcmp(flag, "--ring")) options->ring_frames = parse_unsigned("ring", argv[i], BENCH_RING_CAP);
+        else if (!strcmp(flag, "--iterations")) options->iterations = parse_unsigned("iterations", argv[i], 10000000);
+        else if (!strcmp(flag, "--trials")) options->trials = parse_unsigned("trials", argv[i], 1000);
+        else if (!strcmp(flag, "--warmup")) options->warmup = parse_unsigned("warmup", argv[i], 10000000);
+        else if (!strcmp(flag, "--cpu")) options->cpu = (int)parse_unsigned("cpu", argv[i], CPU_SETSIZE - 1);
+        else if (!strcmp(flag, "--format"))
+        {
+            if (!strcmp(argv[i], "f32")) options->format = FORMAT_F32;
+            else if (!strcmp(argv[i], "s16")) options->format = FORMAT_S16;
+            else { fprintf(stderr, "invalid format: %s\n", argv[i]); exit(2); }
+        }
+        else if (!strcmp(flag, "--gain"))
+        {
+            if (!strcmp(argv[i], "on")) options->apply_gain = 1;
+            else if (!strcmp(argv[i], "off")) options->apply_gain = 0;
+            else { fprintf(stderr, "invalid gain: %s\n", argv[i]); exit(2); }
+        }
+        else { usage(argv[0]); exit(2); }
+    }
+    if (!options->frames || !options->voices || !options->ring_frames || !options->iterations || !options->trials)
+    {
+        fputs("frames, voices, ring, iterations, and trials must be non-zero\n", stderr);
+        exit(2);
+    }
+    if (options->frames > options->ring_frames)
+    {
+        fputs("frames must not exceed ring capacity\n", stderr);
+        exit(2);
+    }
+    if (options->json && options->csv) { fputs("choose JSON or CSV, not both\n", stderr); exit(2); }
+}
+
+static void pin_cpu(int cpu)
+{
+    cpu_set_t set;
+    if (cpu < 0) return;
+    CPU_ZERO(&set);
+    CPU_SET((unsigned)cpu, &set);
+    if (sched_setaffinity(0, sizeof(set), &set))
+    {
+        fprintf(stderr, "sched_setaffinity(cpu %d): %s\n", cpu, strerror(errno));
+        exit(1);
+    }
+}
+
+int main(int argc, char **argv)
+{
+    struct options options;
+    struct bench_voice voices[BENCH_MAX_VOICES] = {{0}};
+    uint64_t times[1000], sorted[1000];
+    float out[2 * MAX_FRAMES];
+    unsigned align, i, voice;
+
+    parse_options(argc, argv, &options);
+    pin_cpu(options.cpu);
+    align = options.format == FORMAT_F32 ? 8 : 4;
+    for (voice = 0; voice < options.voices; voice++)
+    {
+        struct bench_voice *item = &voices[voice];
+        item->format.nChannels = 2;
+        item->format.wBitsPerSample = options.format == FORMAT_F32 ? 32 : 16;
+        item->format.nBlockAlign = align;
+        item->audio = malloc((size_t)options.ring_frames * align);
+        if (!item->audio) { perror("malloc"); return 1; }
+        bench_fill_audio(item->audio, &options);
+        item->initial_offset = (voice * 137u) % options.ring_frames;
+        item->actual.lock = (pthread_mutex_t)PTHREAD_MUTEX_INITIALIZER;
+        item->reference.lock = (pthread_mutex_t)PTHREAD_MUTEX_INITIALIZER;
+        for (i = 0; i < 8; i++)
+            item->actual.vols[i] = item->reference.vols[i] =
+                i & 1 ? -0.75f + (float)(voice % 7) * 0.19f : 0.25f + (float)(voice % 5) * 0.17f;
+    }
+
+    for (voice = 0; voice < options.voices; voice++) reset_voice(&voices[voice], &options);
+    run_blocks(&options, voices, out, options.warmup);
+    for (i = 0; i < options.trials; i++)
+    {
+        for (voice = 0; voice < options.voices; voice++) reset_voice(&voices[voice], &options);
+        times[i] = run_blocks(&options, voices, out, options.iterations);
+    }
+    memcpy(sorted, times, options.trials * sizeof(*sorted));
+    qsort(sorted, options.trials, sizeof(*sorted), compare_u64);
+
+    if (options.csv)
+    {
+        if (options.csv_header)
+            puts("kind,lane,format,frames,voices,iterations,trial,ns_per_block,cpu_us_per_sec_48k,median_ns_per_block,p95_ns_per_block");
+        for (i = 0; i < options.trials; i++)
+            printf("trial,%s,%s,%u,%u,%u,%u,%.3f,%.3f,,\n", LANE_NAME,
+                   options.format == FORMAT_F32 ? "f32" : "s16", options.frames, options.voices,
+                   options.iterations, i, (double)times[i] / options.iterations,
+                   (double)times[i] * 48.0 / ((double)options.iterations * options.frames));
+        printf("summary,%s,%s,%u,%u,%u,,,,%.3f,%.3f\n", LANE_NAME,
+               options.format == FORMAT_F32 ? "f32" : "s16", options.frames, options.voices,
+               options.iterations, (double)sorted[options.trials / 2] / options.iterations,
+               (double)sorted[percentile_index(options.trials, 95)] / options.iterations);
+    }
+    else if (options.json)
+    {
+        printf("{\"lane\":\"%s\",\"format\":\"%s\",\"frames\":%u,\"voices\":%u,\"iterations\":%u,\"trials_ns_per_block\":[",
+               LANE_NAME, options.format == FORMAT_F32 ? "f32" : "s16", options.frames, options.voices, options.iterations);
+        for (i = 0; i < options.trials; i++) printf("%s%.3f", i ? "," : "", (double)times[i] / options.iterations);
+        printf("],\"median_ns_per_block\":%.3f,\"p95_ns_per_block\":%.3f,\"median_cpu_us_per_sec_48k\":%.3f,\"p95_cpu_us_per_sec_48k\":%.3f}\n",
+               (double)sorted[options.trials / 2] / options.iterations,
+               (double)sorted[percentile_index(options.trials, 95)] / options.iterations,
+               (double)sorted[options.trials / 2] * 48.0 / ((double)options.iterations * options.frames),
+               (double)sorted[percentile_index(options.trials, 95)] * 48.0 / ((double)options.iterations * options.frames));
+    }
+    else
+    {
+        printf("lane=%s format=%s frames=%u voices=%u iterations=%u trials=%u median_ns_per_block=%.3f p95_ns_per_block=%.3f median_cpu_us_per_sec_48k=%.3f p95_cpu_us_per_sec_48k=%.3f sink=%" PRIu32 "\n",
+               LANE_NAME, options.format == FORMAT_F32 ? "f32" : "s16", options.frames, options.voices,
+               options.iterations, options.trials, (double)sorted[options.trials / 2] / options.iterations,
+               (double)sorted[percentile_index(options.trials, 95)] / options.iterations,
+               (double)sorted[options.trials / 2] * 48.0 / ((double)options.iterations * options.frames),
+               (double)sorted[percentile_index(options.trials, 95)] * 48.0 / ((double)options.iterations * options.frames), bench_sink);
+    }
+
+    for (voice = 0; voice < options.voices; voice++)
+    {
+        pthread_mutex_destroy(&voices[voice].actual.lock);
+        pthread_mutex_destroy(&voices[voice].reference.lock);
+        free(voices[voice].audio);
+    }
+    return 0;
+}
diff --git a/tools/bench-directaudio-mixer.sh b/tools/bench-directaudio-mixer.sh
new file mode 100755
--- /dev/null
+++ b/tools/bench-directaudio-mixer.sh
@@ -0,0 +1,60 @@
+#!/bin/sh
+# Build three DirectAudio mixer lanes, then run the selected short case in a
+# randomized order.  Defaults are one 48-frame, one-voice case and finish in
+# well under 30 seconds on the target device.
+set -eu
+
+root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
+cc=${CC:-cc}
+build=${DA_MIX_BENCH_BUILD_DIR:-"$root/.bench-build"}
+randomize=0
+seed=20261010
+
+while [ "$#" -gt 0 ]; do
+    case "$1" in
+        --randomized-lanes) randomize=1; shift ;;
+        --seed)
+            [ "$#" -ge 2 ] || { echo "--seed needs a value" >&2; exit 2; }
+            seed=$2; shift 2 ;;
+        --build-dir)
+            [ "$#" -ge 2 ] || { echo "--build-dir needs a value" >&2; exit 2; }
+            build=$2; shift 2 ;;
+        *) break ;;
+    esac
+done
+
+mkdir -p "$build"
+sh "$root/tests/extract-mixer-under-test.sh" "$root/directaudio.c" "$build/directaudio_mix_under_test.inc"
+common="-std=c11 -O2 -Wall -Wextra -Wno-unused-function -I$root -I$build"
+# Baseline deliberately uses the same -O2 as production.  Only the scalar
+# control gets DA_MIX_FORCE_SCALAR, whose production header blocks autovectorization.
+# The default lane is the native AArch64 NEON implementation.
+$cc $common -DDA_BENCH_BASELINE "$root/tools/bench-directaudio-mixer.c" -o "$build/baseline"
+$cc $common -DDA_MIX_FORCE_SCALAR "$root/tools/bench-directaudio-mixer.c" -o "$build/scalar"
+$cc $common "$root/tools/bench-directaudio-mixer.c" -o "$build/neon"
+
+lanes='baseline scalar neon'
+if [ "$randomize" -eq 1 ]; then
+    lanes=$(python3 - "$seed" <<'PY'
+import random
+import sys
+lanes = ["baseline", "scalar", "neon"]
+random.Random(int(sys.argv[1])).shuffle(lanes)
+print(" ".join(lanes))
+PY
+)
+fi
+
+csv=0
+for arg in "$@"; do
+    [ "$arg" = --csv ] && csv=1
+done
+first=1
+for lane in $lanes; do
+    if [ "$csv" -eq 1 ] && [ "$first" -eq 0 ]; then
+        "$build/$lane" "$@" --csv-no-header
+    else
+        "$build/$lane" "$@"
+    fi
+    first=0
+done
