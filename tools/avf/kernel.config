# Overlay for the existing 4 KiB Termux-Aether Arch kernel.
# A separate CI artifact; the headless Arch kernel remains a valid fallback.
CONFIG_LOCALVERSION="-droiddeck-avf"
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_VIRTIO_INPUT=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_VIRTIO=y
