+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef DIRECTAUDIO_DA_MIX_H
+#define DIRECTAUDIO_DA_MIX_H
+
+#include <stdint.h>
+
+#if defined(__aarch64__) && !defined(DA_MIX_FORCE_SCALAR)
+# include <arm_neon.h>
+# define DA_MIX_USE_NEON 1
+#endif
+
+/* GCC otherwise contracts the gain multiply and accumulation at its default
+ * fp-contract=fast setting. Keep the forced scalar path unvectorized as well so
+ * DA_MIX_FORCE_SCALAR remains a meaningful test and benchmark control. */
+#if defined(__GNUC__) && !defined(__clang__)
+# ifdef DA_MIX_FORCE_SCALAR
+#  define DA_MIX_ATTR __attribute__((optimize("fp-contract=off", "no-tree-vectorize")))
+# else
+#  define DA_MIX_ATTR __attribute__((optimize("fp-contract=off")))
+# endif
+#else
+# define DA_MIX_ATTR
+#endif
+
+/* The production caller guarantees non-overlapping input and output spans. */
+static inline DA_MIX_ATTR void da_mix_stereo_f32(float *out, const float *in,
+                                                  unsigned frames, const float gain[2],
+                                                  int apply_gain)
+{
+#ifdef __clang__
+# pragma clang fp contract(off)
+#endif
+#ifdef DA_MIX_USE_NEON
+    unsigned samples = frames * 2, i = 0;
+
+    if (apply_gain)
+    {
+        float32x2_t gain2 = vld1_f32(gain);
+        float32x4_t gain4 = vcombine_f32(gain2, gain2);
+
+        for (; i + 4 <= samples; i += 4)
+        {
+            float32x4_t src = vld1q_f32(in + i);
+            float32x4_t dst = vld1q_f32(out + i);
+            src = vmulq_f32(src, gain4);
+            vst1q_f32(out + i, vaddq_f32(dst, src));
+        }
+        for (; i < samples; i++)
+        {
+            float sample = in[i] * gain[i & 1];
+            out[i] += sample;
+        }
+    }
+    else
+    {
+        for (; i + 4 <= samples; i += 4)
+        {
+            float32x4_t src = vld1q_f32(in + i);
+            float32x4_t dst = vld1q_f32(out + i);
+            vst1q_f32(out + i, vaddq_f32(dst, src));
+        }
+        for (; i < samples; i++) out[i] += in[i];
+    }
+#else
+    unsigned samples = frames * 2, i;
+
+    if (apply_gain)
+    {
+# if defined(__clang__) && defined(DA_MIX_FORCE_SCALAR)
+#  pragma clang loop vectorize(disable) interleave(disable)
+# endif
+        for (i = 0; i < samples; i++)
+        {
+            float sample = in[i] * gain[i & 1];
+            out[i] += sample;
+        }
+    }
+    else
+    {
+# if defined(__clang__) && defined(DA_MIX_FORCE_SCALAR)
+#  pragma clang loop vectorize(disable) interleave(disable)
+# endif
+        for (i = 0; i < samples; i++) out[i] += in[i];
+    }
+#endif
+}
+
+static inline DA_MIX_ATTR void da_mix_stereo_s16(float *out, const int16_t *in,
+                                                  unsigned frames, const float gain[2],
+                                                  int apply_gain)
+{
+#ifdef __clang__
+# pragma clang fp contract(off)
+#endif
+#ifdef DA_MIX_USE_NEON
+    const float scale = 1.0f / 32768.0f;
+    unsigned f = 0;
+    float32x4_t scale4 = vdupq_n_f32(scale);
+
+    if (apply_gain)
+    {
+        float32x2_t gain2 = vld1_f32(gain);
+        float32x4_t gain4 = vcombine_f32(gain2, gain2);
+
+        for (; f + 4 <= frames; f += 4)
+        {
+            int16x8_t packed = vld1q_s16(in + 2 * f);
+            float32x4_t low = vcvtq_f32_s32(vmovl_s16(vget_low_s16(packed)));
+            float32x4_t high = vcvtq_f32_s32(vmovl_s16(vget_high_s16(packed)));
+            float32x4_t dst_low = vld1q_f32(out + 2 * f);
+            float32x4_t dst_high = vld1q_f32(out + 2 * f + 4);
+
+            low = vmulq_f32(low, scale4);
+            high = vmulq_f32(high, scale4);
+            low = vmulq_f32(low, gain4);
+            high = vmulq_f32(high, gain4);
+            vst1q_f32(out + 2 * f, vaddq_f32(dst_low, low));
+            vst1q_f32(out + 2 * f + 4, vaddq_f32(dst_high, high));
+        }
+        for (; f < frames; f++)
+        {
+            float left = in[2 * f] * scale;
+            float right = in[2 * f + 1] * scale;
+            left *= gain[0];
+            right *= gain[1];
+            out[2 * f] += left;
+            out[2 * f + 1] += right;
+        }
+    }
+    else
+    {
+        for (; f + 4 <= frames; f += 4)
+        {
+            int16x8_t packed = vld1q_s16(in + 2 * f);
+            float32x4_t low = vcvtq_f32_s32(vmovl_s16(vget_low_s16(packed)));
+            float32x4_t high = vcvtq_f32_s32(vmovl_s16(vget_high_s16(packed)));
+            float32x4_t dst_low = vld1q_f32(out + 2 * f);
+            float32x4_t dst_high = vld1q_f32(out + 2 * f + 4);
+
+            low = vmulq_f32(low, scale4);
+            high = vmulq_f32(high, scale4);
+            vst1q_f32(out + 2 * f, vaddq_f32(dst_low, low));
+            vst1q_f32(out + 2 * f + 4, vaddq_f32(dst_high, high));
+        }
+        for (; f < frames; f++)
+        {
+            out[2 * f] += in[2 * f] * scale;
+            out[2 * f + 1] += in[2 * f + 1] * scale;
+        }
+    }
+#else
+    const float scale = 1.0f / 32768.0f;
+    unsigned samples = frames * 2, i;
+
+    if (apply_gain)
+    {
+# if defined(__clang__) && defined(DA_MIX_FORCE_SCALAR)
+#  pragma clang loop vectorize(disable) interleave(disable)
+# endif
+        for (i = 0; i < samples; i++)
+        {
+            float sample = in[i] * scale;
+            sample *= gain[i & 1];
+            out[i] += sample;
+        }
+    }
+    else
+    {
+# if defined(__clang__) && defined(DA_MIX_FORCE_SCALAR)
+#  pragma clang loop vectorize(disable) interleave(disable)
+# endif
+        for (i = 0; i < samples; i++) out[i] += in[i] * scale;
+    }
+#endif
+}
+
+#undef DA_MIX_ATTR
+#undef DA_MIX_USE_NEON
+
+#endif /* DIRECTAUDIO_DA_MIX_H */
