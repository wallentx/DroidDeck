# Immutable DirectAudio inputs for the downstream game-unixlib component build.
# The app's release.env selects a completed four-zip component release; this file
# deliberately stays pointed at the source and non-game artifacts this patch set
# was reviewed against.
DIRECTAUDIO_SOURCE_REPOSITORY=The412Banner/directaudio
DIRECTAUDIO_SOURCE_REVISION=52aedbf8ddd42874a5bbd21df20e1046367f442e
DIRECTAUDIO_SOURCE_URL=https://github.com/The412Banner/directaudio.git

# The SIMD change is confined to the game unixlib. Relay and PulseAudio sink
# archives are copied byte-for-byte from this immutable upstream release.
DIRECTAUDIO_UPSTREAM_RELEASE_REPOSITORY=The412Banner/directaudio
DIRECTAUDIO_UPSTREAM_RELEASE_TAG=directaudio-linux-v1.1.0
DIRECTAUDIO_UPSTREAM_RELAY_SHA256=b68eb6d7a892fd92a1cd73fac36dc05cabb77cc73792e2c582d3eeccad355942
DIRECTAUDIO_UPSTREAM_SINK_SHA256=1d5d3ed709e5389ef7603f019c62b07e4e8428bb42882193d4a144a5c15425b6
