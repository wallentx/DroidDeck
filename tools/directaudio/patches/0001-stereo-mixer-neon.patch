diff --git a/tests/directaudio_mixer_semantics_test.c b/tests/directaudio_mixer_semantics_test.c
new file mode 100644
--- /dev/null
+++ b/tests/directaudio_mixer_semantics_test.c
@@ -0,0 +1,386 @@
+/*
+ * Regression contract for the DirectAudio same-rate packed stereo fast paths.
+ *
+ * The system under test is extracted at test time from directaudio.c by
+ * extract-mixer-under-test.sh.  ref_mix_voice below is the pinned generic
+ * behavior from The412Banner/directaudio 52aedbf8ddd42874a5bbd21df20e1046367f442e
+ * (directaudio.c's samp_to_float/downmix_stereo/voice_frame_stereo/mix_voice),
+ * with only names and locking removed.  It remains intentionally scalar so a
+ * changed optimization is compared with original externally visible results.
+ */
+#include <math.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef uint8_t BYTE;
+typedef int16_t INT16;
+typedef int32_t INT32;
+typedef uint32_t UINT32;
+typedef int BOOL;
+
+typedef struct
+{
+    uint16_t wFormatTag;
+    uint16_t nChannels;
+    uint32_t nSamplesPerSec;
+    uint32_t nAvgBytesPerSec;
+    uint16_t nBlockAlign;
+    uint16_t wBitsPerSample;
+    uint16_t cbSize;
+} WAVEFORMATEX;
+
+struct directaudio_stream
+{
+    pthread_mutex_t lock;
+    BOOL playing;
+    UINT32 bufsize_frames;
+    UINT32 lcl_offs_frames;
+    UINT32 held_frames;
+    WAVEFORMATEX *fmt;
+    BYTE *local_buffer;
+    int32_t aa_rate;
+    float vols[8];
+    BOOL vols_active;
+    double rs_pos;
+    BOOL is_float;
+};
+
+#define MIX_OUT_RATE 48000
+#define min(a, b) ((a) < (b) ? (a) : (b))
+
+#include "da_mix.h"
+/* The extracted and pinned-original helpers retain DirectAudio's exact
+ * float s[8] shape.  GCC cannot infer the source driver's format validation
+ * from their standalone signatures and warns that a zero-channel call might
+ * pass an uninitialized element to downmix_stereo.  This fixture only creates
+ * nonzero channel formats; retain the original code rather than changing the
+ * timed generic baseline or the extracted production slice. */
+#if defined(__GNUC__) && !defined(__clang__)
+# pragma GCC diagnostic push
+# pragma GCC diagnostic ignored "-Wmaybe-uninitialized"
+#endif
+#include "directaudio_mix_under_test.inc"
+
+enum { GUARD = 16, MAX_FRAMES = 480, RING_FRAMES = 521 };
+
+static void fail(const char *what, unsigned frames, unsigned mode, unsigned sample)
+{
+    fprintf(stderr, "FAIL %s (frames=%u mode=%u sample=%u)\n", what, frames, mode, sample);
+    abort();
+}
+
+static uint32_t bits(float x)
+{
+    uint32_t out;
+    memcpy(&out, &x, sizeof(out));
+    return out;
+}
+
+static float from_bits(uint32_t x)
+{
+    float out;
+    memcpy(&out, &x, sizeof(out));
+    return out;
+}
+
+/* Finite values, infinities, and signed zero must be bit exact.  IEEE NaN
+ * payload propagation is architecture-defined, so both results must be NaN. */
+static int same_sample(float expected, float actual)
+{
+    if (isnan(expected) || isnan(actual)) return isnan(expected) && isnan(actual);
+    return bits(expected) == bits(actual);
+}
+
+/* Pinned original generic semantics; see the provenance comment above. */
+static float ref_samp_to_float(const struct directaudio_stream *v, const BYTE *frame, int c)
+{
+    if (v->is_float) return ((const float *)frame)[c];
+
+    switch (v->fmt->wBitsPerSample)
+    {
+    case 16: return ((const INT16 *)frame)[c] * (1.0f / 32768.0f);
+    case 32: return ((const INT32 *)frame)[c] * (1.0f / 2147483648.0f);
+    case 8: return (((const BYTE *)frame)[c] - 128) * (1.0f / 128.0f);
+    case 24:
+    {
+        const BYTE *p = frame + c * 3;
+        INT32 s = p[0] | (p[1] << 8) | (p[2] << 16);
+        if (s & 0x800000) s |= ~0xffffff;
+        return s * (1.0f / 8388608.0f);
+    }
+    default: return 0.0f;
+    }
+}
+
+static void ref_downmix_stereo(int ch, const float *s, float *left, float *right)
+{
+    const float c = 0.7071f;
+    switch (ch)
+    {
+    case 1: *left = *right = s[0]; return;
+    case 2: *left = s[0]; *right = s[1]; return;
+    case 3: *left = s[0]; *right = s[1]; return;
+    case 4: *left = s[0] + c * s[2]; *right = s[1] + c * s[3]; return;
+    case 6: *left = s[0] + c * s[2] + c * s[4];
+            *right = s[1] + c * s[2] + c * s[5]; return;
+    case 8: *left = s[0] + c * s[2] + c * s[4] + c * s[6];
+            *right = s[1] + c * s[2] + c * s[5] + c * s[7]; return;
+    default: *left = s[0]; *right = ch > 1 ? s[1] : s[0]; return;
+    }
+}
+
+static void ref_voice_frame_stereo(struct directaudio_stream *v, UINT32 idx,
+                                   float *left, float *right)
+{
+    UINT32 pos = (v->lcl_offs_frames + idx) % v->bufsize_frames;
+    const BYTE *frame = v->local_buffer + (size_t)pos * v->fmt->nBlockAlign;
+    int ch = v->fmt->nChannels, c;
+    float samples[8];
+
+    if (ch > 8) ch = 8;
+    for (c = 0; c < ch; c++)
+    {
+        float value = ref_samp_to_float(v, frame, c);
+        if (v->vols_active) value *= v->vols[c < 8 ? c : 7];
+        samples[c] = value;
+    }
+    ref_downmix_stereo(ch, samples, left, right);
+}
+
+static void ref_mix_voice(struct directaudio_stream *v, float *out, int32_t num_frames)
+{
+    if (!v->playing || v->held_frames == 0) return;
+
+    if (v->aa_rate == MIX_OUT_RATE)
+    {
+        UINT32 n = min((UINT32)num_frames, v->held_frames), f;
+        for (f = 0; f < n; f++)
+        {
+            float left, right;
+            ref_voice_frame_stereo(v, f, &left, &right);
+            out[2 * f] += left;
+            out[2 * f + 1] += right;
+        }
+        v->lcl_offs_frames = (v->lcl_offs_frames + n) % v->bufsize_frames;
+        v->held_frames -= n;
+    }
+    else
+    {
+        double ratio = (double)v->aa_rate / MIX_OUT_RATE;
+        int32_t f, consumed;
+        for (f = 0; f < num_frames; f++)
+        {
+            UINT32 i0 = (UINT32)v->rs_pos;
+            float l0, r0, l1, r1;
+            double frac;
+
+            if (i0 + 1 >= v->held_frames) break;
+            ref_voice_frame_stereo(v, i0, &l0, &r0);
+            ref_voice_frame_stereo(v, i0 + 1, &l1, &r1);
+            frac = v->rs_pos - i0;
+            out[2 * f] += (float)(l0 + (l1 - l0) * frac);
+            out[2 * f + 1] += (float)(r0 + (r1 - r0) * frac);
+            v->rs_pos += ratio;
+        }
+        consumed = (int32_t)v->rs_pos;
+        if (consumed > (int32_t)v->held_frames) consumed = v->held_frames;
+        if (consumed > 0)
+        {
+            v->lcl_offs_frames = (v->lcl_offs_frames + consumed) % v->bufsize_frames;
+            v->held_frames -= consumed;
+            v->rs_pos -= consumed;
+        }
+        if (v->held_frames == 0) v->rs_pos = 0.0;
+    }
+}
+
+#if defined(__GNUC__) && !defined(__clang__)
+# pragma GCC diagnostic pop
+#endif
+
+static uint32_t next_random(uint32_t *state)
+{
+    *state = *state * 1664525u + 1013904223u;
+    return *state;
+}
+
+static void fill_audio(BYTE *data, const WAVEFORMATEX *fmt, BOOL is_float)
+{
+    static const uint32_t f32_values[] = {
+        0x00000000u, 0x80000000u, 0x00000001u, 0x80000001u,
+        0x3f800000u, 0xbf800000u, 0x7f800000u, 0xff800000u,
+        0x7fc01234u, 0xffc05678u, 0x3eaaaaabu, 0xbeaaaaabu,
+    };
+    static const INT16 s16_values[] = {-32768, -32767, -1, 0, 1, 32767, 12345, -23456};
+    uint32_t random = 0x3c6ef372u;
+    unsigned frame, channel;
+
+    for (frame = 0; frame < RING_FRAMES; frame++)
+    {
+        BYTE *dst = data + (size_t)frame * fmt->nBlockAlign;
+        memset(dst, 0xa5, fmt->nBlockAlign);
+        for (channel = 0; channel < fmt->nChannels && channel < 9; channel++)
+        {
+            if (is_float)
+            {
+                float value = from_bits(f32_values[(frame * 3 + channel) %
+                                                   (sizeof(f32_values) / sizeof(f32_values[0]))]);
+                memcpy(dst + channel * sizeof(float), &value, sizeof(value));
+            }
+            else if (fmt->wBitsPerSample == 16)
+            {
+                INT16 value = s16_values[(frame * 5 + channel) %
+                                         (sizeof(s16_values) / sizeof(s16_values[0]))];
+                memcpy(dst + channel * sizeof(value), &value, sizeof(value));
+            }
+            else if (fmt->wBitsPerSample == 8)
+            {
+                dst[channel] = (BYTE)next_random(&random);
+            }
+            else if (fmt->wBitsPerSample == 24)
+            {
+                uint32_t value = next_random(&random);
+                dst[3 * channel] = (BYTE)value;
+                dst[3 * channel + 1] = (BYTE)(value >> 8);
+                dst[3 * channel + 2] = (BYTE)(value >> 16);
+            }
+            else
+            {
+                INT32 value = (INT32)next_random(&random);
+                memcpy(dst + channel * sizeof(value), &value, sizeof(value));
+            }
+        }
+    }
+}
+
+static void fill_output(float *out)
+{
+    static const uint32_t values[] = {
+        0x00000000u, 0x80000000u, 0x3dccccddu, 0xbdccccddu,
+        0x3f000000u, 0xbf000000u, 0x00000001u, 0x80000001u,
+    };
+    unsigned i;
+    for (i = 0; i < 2 * MAX_FRAMES; i++)
+        out[i] = from_bits(values[i % (sizeof(values) / sizeof(values[0]))]);
+}
+
+struct test_case
+{
+    unsigned channels;
+    unsigned bits_per_sample;
+    unsigned block_align;
+    BOOL is_float;
+    int rate;
+    BOOL gains_active;
+    unsigned wrap_mode;
+    unsigned held_short;
+};
+
+static void run_case(const struct test_case *tc, unsigned frames)
+{
+    WAVEFORMATEX format = {0};
+    struct directaudio_stream actual = {0}, expected = {0};
+    float *actual_storage, *expected_storage;
+    float *actual_out, *expected_out;
+    BYTE *audio, *audio_before;
+    size_t audio_bytes = (size_t)RING_FRAMES * tc->block_align;
+    unsigned i, n = frames;
+    const float gains[][2] = {{1.0f, 1.0f}, {0.0f, 0.0f}, {0.25f, -0.75f}, {2.0f, 3.5f}};
+
+    format.nChannels = (uint16_t)tc->channels;
+    format.wBitsPerSample = (uint16_t)tc->bits_per_sample;
+    format.nBlockAlign = (uint16_t)tc->block_align;
+    audio = malloc(audio_bytes);
+    audio_before = malloc(audio_bytes);
+    actual_storage = malloc((2 * GUARD + 2 * MAX_FRAMES) * sizeof(*actual_storage));
+    expected_storage = malloc((2 * GUARD + 2 * MAX_FRAMES) * sizeof(*expected_storage));
+    if (!audio || !audio_before || !actual_storage || !expected_storage) abort();
+
+    fill_audio(audio, &format, tc->is_float);
+    memcpy(audio_before, audio, audio_bytes);
+    for (i = 0; i < GUARD; i++)
+    {
+        actual_storage[i] = expected_storage[i] = from_bits(0x7fc0deadu);
+        actual_storage[GUARD + 2 * MAX_FRAMES + i] =
+            expected_storage[GUARD + 2 * MAX_FRAMES + i] = from_bits(0x7fc0deadu);
+    }
+    actual_out = actual_storage + GUARD;
+    expected_out = expected_storage + GUARD;
+    fill_output(actual_out);
+    memcpy(expected_out, actual_out, 2 * MAX_FRAMES * sizeof(*actual_out));
+
+    actual.lock = (pthread_mutex_t)PTHREAD_MUTEX_INITIALIZER;
+    expected.lock = (pthread_mutex_t)PTHREAD_MUTEX_INITIALIZER;
+    actual.playing = expected.playing = 1;
+    actual.bufsize_frames = expected.bufsize_frames = RING_FRAMES;
+    actual.held_frames = expected.held_frames = tc->held_short && n ? n - 1 : n;
+    actual.fmt = expected.fmt = &format;
+    actual.local_buffer = expected.local_buffer = audio;
+    actual.aa_rate = expected.aa_rate = tc->rate;
+    actual.is_float = expected.is_float = tc->is_float;
+    actual.vols_active = expected.vols_active = tc->gains_active;
+    actual.rs_pos = expected.rs_pos = tc->rate == MIX_OUT_RATE ? 0.0 : 0.25;
+    for (i = 0; i < 8; i++) actual.vols[i] = expected.vols[i] = gains[tc->wrap_mode % 4][i & 1];
+
+    if (n == 0) actual.lcl_offs_frames = expected.lcl_offs_frames = RING_FRAMES - 1;
+    else if (tc->wrap_mode == 0) actual.lcl_offs_frames = expected.lcl_offs_frames = 3;
+    else if (tc->wrap_mode == 1) actual.lcl_offs_frames = expected.lcl_offs_frames = RING_FRAMES - n;
+    else
+    {
+        /* Modes 2, 3, and 4 leave respectively 1, 2, and 3 frames after
+         * the ring wrap.  Tiny blocks cannot wrap by more frames than they
+         * contain, so they still cover the exact-end boundary. */
+        unsigned tail = tc->wrap_mode - 1;
+        if (tail >= n) tail = n - 1;
+        actual.lcl_offs_frames = expected.lcl_offs_frames = RING_FRAMES - n + tail;
+    }
+
+    mix_voice(&actual, actual_out, (int32_t)frames);
+    ref_mix_voice(&expected, expected_out, (int32_t)frames);
+
+    for (i = 0; i < 2 * MAX_FRAMES; i++)
+        if (!same_sample(expected_out[i], actual_out[i])) fail("output", frames, tc->wrap_mode, i);
+    for (i = 0; i < GUARD; i++)
+        if (bits(actual_storage[i]) != 0x7fc0deadu ||
+            bits(actual_storage[GUARD + 2 * MAX_FRAMES + i]) != 0x7fc0deadu)
+            fail("output guard", frames, tc->wrap_mode, i);
+    if (memcmp(audio, audio_before, audio_bytes)) fail("input modified", frames, tc->wrap_mode, 0);
+    if (actual.lcl_offs_frames != expected.lcl_offs_frames ||
+        actual.held_frames != expected.held_frames || actual.rs_pos != expected.rs_pos)
+        fail("ring accounting", frames, tc->wrap_mode, 0);
+
+    pthread_mutex_destroy(&actual.lock);
+    pthread_mutex_destroy(&expected.lock);
+    free(expected_storage);
+    free(actual_storage);
+    free(audio_before);
+    free(audio);
+}
+
+int main(void)
+{
+    static const unsigned frames[] = {0, 1, 2, 3, 4, 7, 8, 47, 48, 95, 96, 191, 192, 479, 480};
+    static const struct test_case cases[] = {
+        {2, 32, 8, 1, 48000, 0, 0, 0}, {2, 32, 8, 1, 48000, 1, 1, 0},
+        {2, 32, 8, 1, 48000, 1, 2, 0}, {2, 32, 8, 1, 48000, 1, 3, 0},
+        {2, 32, 8, 1, 48000, 1, 4, 0}, {2, 16, 4, 0, 48000, 0, 0, 0},
+        {2, 16, 4, 0, 48000, 1, 1, 0}, {2, 16, 4, 0, 48000, 1, 2, 1},
+        {2, 16, 4, 0, 48000, 1, 3, 0}, {2, 16, 4, 0, 48000, 1, 4, 0},
+        {2, 32, 12, 1, 48000, 1, 2, 0}, {2, 16, 6, 0, 48000, 1, 2, 0},
+        {1, 32, 4, 1, 48000, 1, 2, 0}, {3, 16, 6, 0, 48000, 1, 2, 0},
+        {6, 16, 12, 0, 48000, 1, 2, 0}, {8, 16, 16, 0, 48000, 1, 2, 0},
+        {9, 16, 18, 0, 48000, 1, 2, 0}, {2, 8, 2, 0, 48000, 1, 2, 0},
+        {2, 24, 6, 0, 48000, 1, 2, 0}, {2, 32, 8, 0, 48000, 1, 2, 0},
+        {2, 32, 8, 1, 44100, 1, 2, 0}, {2, 16, 4, 0, 44100, 1, 2, 1},
+    };
+    unsigned i, j;
+
+    for (i = 0; i < sizeof(cases) / sizeof(cases[0]); i++)
+        for (j = 0; j < sizeof(frames) / sizeof(frames[0]); j++)
+            run_case(&cases[i], frames[j]);
+    puts("directaudio mixer semantics: passed");
+    return 0;
+}
diff --git a/tests/run-mixer-semantics.sh b/tests/run-mixer-semantics.sh
new file mode 100755
